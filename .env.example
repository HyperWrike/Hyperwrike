# ============================================================
# Hyperwrike site env — copy to .env on the server and fill in.
# ============================================================

# --- OpenCode Zen (AI chatbot "Hyper"). Leave blank to use the
#     built-in helpful responder until you have a key. ---
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=claude-sonnet-4

# --- Brevo (optional: emails contact-form leads to your inbox) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=team@hyperwrike.com
BREVO_SENDER_NAME=Hyperwrike
BREVO_NOTIFICATION_INBOX=team@hyperwrike.com

# --- Server ---
PORT=8080
